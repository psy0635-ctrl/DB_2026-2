        <mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;fontStyle=1;html=1;fontSize=18;fontFamily=Arial;whiteSpace=wrap;" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;패션 상품 옵션별 재고·주문 관리 — 개념 ERD&lt;/font&gt;" vertex="1">
